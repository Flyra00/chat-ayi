<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- NVIDIA Dark Theme Colors -->
    <Color x:Key="Primary">#76B900</Color>
    <Color x:Key="PrimaryDark">#5a8f00</Color>
    <Color x:Key="Secondary">#1a1a1a</Color>
    <Color x:Key="Tertiary">#0d0d0d</Color>

    <Color x:Key="NvidiaDark">#1a1a1a</Color>
    <Color x:Key="NvidiaDarker">#0d0d0d</Color>
    <Color x:Key="NvidiaGreen">#76B900</Color>
    <Color x:Key="NvidiaGreenHover">#5a8f00</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="SecondaryDarkText">#000000</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Chat surfaces (dark theme + green accent) -->
    <Color x:Key="ChatBackground">#0B0C0B</Color>
    <Color x:Key="ChatSurface">#111311</Color>
    <Color x:Key="ChatSurface2">#0F100F</Color>
    <Color x:Key="ChatStroke">#212621</Color>
    <Color x:Key="ChatStrokeStrong">#2A322A</Color>

    <Color x:Key="ChatAssistantBubble">#161816</Color>
    <Color x:Key="ChatAssistantBubbleStroke">#2C322C</Color>
    <Color x:Key="ChatUserBubble">#1A5E2B</Color>
    <Color x:Key="ChatUserBubbleStroke">#40A14B</Color>
    <Color x:Key="ChatUserBubbleGlow">#76B900</Color>
    <Color x:Key="ChatAssistantBubbleText">#E6E8E6</Color>
    <Color x:Key="ChatUserBubbleText">#F4FAF4</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="{StaticResource ChatBackground}"/>
    <SolidColorBrush x:Key="ChatSurfaceBrush" Color="{StaticResource ChatSurface}"/>
    <SolidColorBrush x:Key="ChatSurface2Brush" Color="{StaticResource ChatSurface2}"/>
    <SolidColorBrush x:Key="ChatStrokeBrush" Color="{StaticResource ChatStroke}"/>
    <SolidColorBrush x:Key="ChatStrokeStrongBrush" Color="{StaticResource ChatStrokeStrong}"/>

    <SolidColorBrush x:Key="ChatAssistantBubbleBrush" Color="{StaticResource ChatAssistantBubble}"/>
    <SolidColorBrush x:Key="ChatAssistantBubbleStrokeBrush" Color="{StaticResource ChatAssistantBubbleStroke}"/>
    <SolidColorBrush x:Key="ChatUserBubbleBrush" Color="{StaticResource ChatUserBubble}"/>
    <SolidColorBrush x:Key="ChatUserBubbleStrokeBrush" Color="{StaticResource ChatUserBubbleStroke}"/>

    <!-- Tool menu surfaces -->
    <Color x:Key="ToolMenuBackground">#181A18</Color>
    <Color x:Key="ToolMenuStroke">#2B312B</Color>
    <Color x:Key="ToolMenuHover">#252825</Color>
    <SolidColorBrush x:Key="ToolMenuBackgroundBrush" Color="{StaticResource ToolMenuBackground}"/>
    <SolidColorBrush x:Key="ToolMenuStrokeBrush" Color="{StaticResource ToolMenuStroke}"/>

    <!-- Active tool chip -->
    <Color x:Key="ActiveToolChipBg">#1B3A0A</Color>
    <Color x:Key="ActiveToolChipStroke">#3D6B15</Color>
    <SolidColorBrush x:Key="ActiveToolChipBgBrush" Color="{StaticResource ActiveToolChipBg}"/>
    <SolidColorBrush x:Key="ActiveToolChipStrokeBrush" Color="{StaticResource ActiveToolChipStroke}"/>

    <!-- Offline banner -->
    <Color x:Key="OfflineBannerBg">#3D2A00</Color>
    <Color x:Key="OfflineBannerStroke">#5C4100</Color>
    <SolidColorBrush x:Key="OfflineBannerBgBrush" Color="{StaticResource OfflineBannerBg}"/>
    <SolidColorBrush x:Key="OfflineBannerStrokeBrush" Color="{StaticResource OfflineBannerStroke}"/>

    <!-- Empty state prompt chips -->
    <Color x:Key="PromptChipBg">#181A18</Color>
    <Color x:Key="PromptChipStroke">#2A302A</Color>
    <SolidColorBrush x:Key="PromptChipBgBrush" Color="{StaticResource PromptChipBg}"/>
    <SolidColorBrush x:Key="PromptChipStrokeBrush" Color="{StaticResource PromptChipStroke}"/>

    <!-- Composer button states -->
    <Color x:Key="ComposerSendDisabledBg">#3A3A3A</Color>
    <Color x:Key="ComposerSendDisabledText">#777777</Color>

    <!-- GetStarted landing -->
    <Color x:Key="GetStartedBackgroundTop">#101110</Color>
    <Color x:Key="GetStartedBackgroundBottom">#0B0C0B</Color>
    <Color x:Key="GetStartedHeroStart">#151815</Color>
    <Color x:Key="GetStartedHeroEnd">#0E100E</Color>
    <Color x:Key="GetStartedHeroStroke">#2B322B</Color>
    <Color x:Key="GetStartedGlow">#76B900</Color>
    <Color x:Key="GetStartedPreviewUser">#1A5E2B</Color>
    <Color x:Key="GetStartedPreviewAssistant">#171917</Color>
    <Color x:Key="GetStartedPreviewStroke">#273027</Color>
    <Color x:Key="GetStartedChipBg">#171917</Color>
    <Color x:Key="GetStartedChipStroke">#2A312A</Color>
    <Color x:Key="GetStartedButtonDisabledBg">#343634</Color>
    <Color x:Key="GetStartedButtonDisabledText">#777777</Color>
</ResourceDictionary>
