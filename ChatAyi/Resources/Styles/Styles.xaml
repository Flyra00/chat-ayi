    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  ChatAyi  ·  Offline Banner Styles                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="OfflineBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OfflineBannerBgBrush}" />
        <Setter Property="Stroke" Value="{StaticResource OfflineBannerStrokeBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  GetStarted  ·  Landing Styles                        -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="GetStartedPageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GetStartedBackgroundTop}" Offset="0" />
        <GradientStop Color="{StaticResource GetStartedBackgroundBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GetStartedHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GetStartedHeroStart}" Offset="0" />
        <GradientStop Color="{StaticResource GetStartedHeroEnd}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="GetStartedRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="20,16,20,20" />
        <Setter Property="RowSpacing" Value="16" />
    </Style>

    <Style x:Key="GetStartedBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NvidiaGreen}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="GetStartedHeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GetStartedHeroBrush}" />
        <Setter Property="Stroke" Value="{StaticResource GetStartedHeroStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="GetStartedHeroTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="GetStartedHeroSubtitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Gray200}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="GetStartedBenefitTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Gray100}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="GetStartedPreviewCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChatSurface2Brush}" />
        <Setter Property="Stroke" Value="{StaticResource GetStartedPreviewStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="GetStartedChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GetStartedChipBg}" />
        <Setter Property="Stroke" Value="{StaticResource GetStartedChipStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="GetStartedChipTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Gray200}" />
    </Style>

    <Style x:Key="GetStartedCtaButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource NvidiaGreen}" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource GetStartedButtonDisabledText}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource GetStartedButtonDisabledBg}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="GetStartedFooterTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Gray400}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
